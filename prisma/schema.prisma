// CRM schema — learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeadStage {
  NUEVO
  INTERESADO
  EN_PROCESO_DE_COMPRA
  CLIENTE
  PERDIDO
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  SIMULADOR
}

enum MessageDirection {
  ENTRANTE
  SALIENTE
}

enum UserRole {
  ADMIN
  AGENTE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(AGENTE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Configuración de la instalación. Fila única (id = "singleton").
model Settings {
  id String @id @default("singleton")

  businessName String  @default("Mi CRM")
  logo         String? // data URI (data:image/...;base64,...)
  brandColor   String? // hex, p. ej. "#4f46e5"

  // IA
  aiProvider        String  @default("simulation") // "simulation" | "anthropic"
  aiApiKey          String?
  aiModel           String  @default("claude-opus-5")
  aiBusinessContext String  @default("")

  // Motor de simulación (JSON en texto)
  colorWords String @default("[]")

  // Canales de Meta
  metaVerifyToken   String?
  waToken           String?
  waPhoneId         String?
  igToken           String?
  igAccountId       String?

  // Control del creador
  disabledModules String  @default("[]") // JSON: ["inbox","pipeline","ia"]
  creatorNotice   String? // aviso mostrado dentro del CRM a todos los usuarios

  // Licencia: cobro previo a permitir el primer uso (/setup) de esta instalación.
  licenseEnabled             Boolean @default(false)
  licensePaid                Boolean @default(false)
  licensePriceLabel          String? // texto libre, p. ej. "$49 USD"
  licensePaymentInstructions String? // métodos de pago (Zelle, Binance, pago móvil, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Comprobante de pago enviado por un comprador para desbloquear la instalación.
/// Lo revisa el creador manualmente desde /creador.
model LicensePaymentClaim {
  id          String    @id @default(cuid())
  reference   String // referencia/comprobante que escribe el comprador
  method      String? // p. ej. "Zelle", "Binance", "Pago móvil"
  contactInfo String? // email o teléfono para responderle
  status      String    @default("pending") // pending | approved | rejected
  note        String? // nota del creador (p. ej. motivo de rechazo)
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?

  @@index([status])
}

/// Producto o servicio del catálogo del negocio. La IA se apoya en estos
/// datos para entender qué vende el negocio (varía según el nicho).
model Product {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  price       Float?
  sku         String?
  keywords    String   @default("[]") // JSON: sinónimos/variantes para detectarlo en texto
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
}

model Contact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String?
  email     String? @unique
  phone     String?
  company   String?
  notes     String?

  // Datos de canales de mensajería
  whatsappId  String? @unique
  instagramId String? @unique

  // Sectorización con IA (resumen a nivel de contacto)
  stage         LeadStage @default(NUEVO)
  interestScore Int?
  aiSummary     String?
  aiDesired     String?
  aiNextStep    String?
  aiAnalyzedAt  DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]

  @@index([company])
  @@index([stage])
}

model Conversation {
  id         String      @id @default(cuid())
  channel    ChannelType
  externalId String
  contactId  String
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unread             Boolean  @default(true)

  // Análisis de IA de esta conversación
  aiStage      LeadStage?
  aiInterest   Int?
  aiDesired    String?
  aiSentiment  String?
  aiSignals    String? // JSON: presupuesto, urgencia, objeciones
  aiSummary    String?
  aiNextStep   String?
  aiDraftReply String?
  aiAnalyzedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@unique([channel, externalId])
  @@index([lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  body           String
  externalId     String?          @unique
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
}
