# Cadena de conexión a PostgreSQL usada por Prisma y por la app Next.js
DATABASE_URL="postgresql://usuario:password@localhost:5432/crm?schema=public"

# --- Acceso de creador (opcional) --------------------------------------
# Define las dos para habilitar el panel /creador con ese correo.
# CREATOR_EMAIL="jesus.delmarg@gmail.com"
# CREATOR_PASSWORD="una-contraseña-larga"

